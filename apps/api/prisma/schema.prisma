datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  SUPER_ADMIN
  ADMIN
  FACILITY_MANAGER
  DEPARTMENT_MANAGER
  TEAM_LEADER
  STAFF
  TEACHER
}

enum TaskStatus {
  NEW
  ASSIGNED
  IN_PROGRESS
  BLOCKED
  PENDING_REVIEW
  COMPLETED
  CANCELLED
  OVERDUE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum AssignmentTargetType {
  USER
  TEAM
  DEPARTMENT
}

model Facility {
  id          String       @id @default(uuid())
  name        String
  code        String       @unique
  address     String?
  managerId   String?
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  departments Department[]
  users       User[]
  tasks       Task[]

  @@map("facilities")
}

model Department {
  id          String       @id @default(uuid())
  facilityId  String
  name        String
  code        String
  managerId   String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  facility    Facility     @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  teams       Team[]
  users       User[]
  tasks       Task[]

  @@map("departments")
}

model Team {
  id           String      @id @default(uuid())
  departmentId String
  name         String
  leaderId     String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  department   Department  @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  users        User[]
  tasks        Task[]

  @@map("teams")
}

model User {
  id           String      @id @default(uuid())
  email        String      @unique
  passwordHash String
  fullName     String
  role         Role        @default(STAFF)
  facilityId   String?
  departmentId String?
  teamId       String?
  managerId    String?
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  facility     Facility?   @relation(fields: [facilityId], references: [id], onDelete: SetNull)
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  team         Team?       @relation(fields: [teamId], references: [id], onDelete: SetNull)

  createdTasks  Task[]     @relation("TaskCreator")
  assignedTasks Task[]     @relation("TaskAssignee")

  @@map("users")
}

model Task {
  id                   String               @id @default(uuid())
  title                String
  description          String?
  status               TaskStatus           @default(NEW)
  priority             TaskPriority         @default(MEDIUM)
  startDate            DateTime?
  dueDate              DateTime?
  facilityId           String
  departmentId         String?
  teamId               String?
  creatorId            String
  assignmentTargetType AssignmentTargetType @default(USER)
  assigneeUserId       String?
  assigneeTeamId       String?
  assigneeDepartmentId String?
  completedAt          DateTime?
  completedById        String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  facility             Facility             @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  department           Department?          @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  team                 Team?                @relation(fields: [teamId], references: [id], onDelete: SetNull)
  creator              User                 @relation("TaskCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  assigneeUser         User?                @relation("TaskAssignee", fields: [assigneeUserId], references: [id], onDelete: SetNull)

  @@index([facilityId, status])
  @@index([assigneeUserId, status])
  @@index([dueDate])
  @@map("tasks")
}
