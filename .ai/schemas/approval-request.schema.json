{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Approval Request",
  "type": "object",
  "required": [
    "id",
    "task_id",
    "reason",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "task_id": {
      "type": "string"
    },
    "reason": {
      "type": "string"
    },
    "impact": {
      "type": "object"
    },
    "alternatives": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "recommendation": {
      "type": "string"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "enum": [
        "PENDING",
        "APPROVED",
        "REJECTED",
        "REQUEST_CHANGES",
        "DEFERRED"
      ]
    }
  }
}