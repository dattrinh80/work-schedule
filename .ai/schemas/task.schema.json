{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Harness Task",
  "type": "object",
  "required": [
    "id",
    "type",
    "title",
    "objective",
    "acceptance_criteria",
    "risk"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "type": {
      "enum": [
        "FEATURE",
        "BUGFIX",
        "REFACTOR",
        "MIGRATION",
        "SECURITY_FIX",
        "UI_REFINEMENT",
        "DOCUMENTATION",
        "RELEASE"
      ]
    },
    "title": {
      "type": "string"
    },
    "objective": {
      "type": "string"
    },
    "scope": {
      "type": "object"
    },
    "source_of_truth": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "risk": {
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "unresolved_questions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}