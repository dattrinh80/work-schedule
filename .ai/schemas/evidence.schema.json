{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Evidence Package",
  "type": "object",
  "required": [
    "task_id",
    "changed_files",
    "verification",
    "residual_risks"
  ],
  "properties": {
    "task_id": {
      "type": "string"
    },
    "changed_files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "verification": {
      "type": "object"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "approvals": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "residual_risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}