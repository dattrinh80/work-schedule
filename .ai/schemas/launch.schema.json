{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Worker Launch",
  "type": "object",
  "required": [
    "task_id",
    "worker_id",
    "runtime",
    "worktree_path",
    "status",
    "timeout_seconds"
  ],
  "properties": {
    "task_id": {
      "type": "string"
    },
    "worker_id": {
      "type": "string"
    },
    "runtime": {
      "enum": [
        "generic",
        "codex",
        "claude-code"
      ]
    },
    "worktree_path": {
      "type": "string"
    },
    "status": {
      "enum": [
        "QUEUED",
        "STARTING",
        "RUNNING",
        "SUCCEEDED",
        "FAILED",
        "TIMED_OUT",
        "CANCELLED"
      ]
    },
    "timeout_seconds": {
      "type": "integer",
      "minimum": 1
    },
    "command": {
      "type": [
        "string",
        "null"
      ]
    },
    "started_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "finished_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "exit_code": {
      "type": [
        "integer",
        "null"
      ]
    }
  }
}